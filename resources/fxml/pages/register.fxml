<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="form" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
    prefHeight="640.0" prefWidth="700.0"
    styleClass="auth-page" stylesheets="@../../assets/css/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controllers.RegisterController">
    <fx:define>
        <Button fx:id="headerLoginButton" text="LOGIN" mnemonicParsing="false" styleClass="o-control, app-button, app-button--primary" prefHeight="30.0" prefWidth="191.0" />
    </fx:define>
    <children>
        <AnchorPane styleClass="auth-page__body" layoutY="109.0" prefHeight="531.0" prefWidth="700.0">
            <children>
                <Label styleClass="auth-page__title" alignment="CENTER" layoutX="200.0" layoutY="27.0" prefWidth="300.0" text="PLEASE REGISTER">
                </Label>
                <Label text="Пароль: 15–128 символов. Можно использовать фразу." styleClass="auth-page__hint" alignment="CENTER" layoutX="40.0" layoutY="72.0" prefWidth="620.0" />
                <TextField fx:id="registerLoginField" promptText="login" styleClass="o-control, field" layoutX="250.0" layoutY="98.0" prefHeight="40.0" prefWidth="200.0">
                    <properties validationField="login" />
                </TextField>
                <TextField fx:id="registerEmailField" promptText="email" styleClass="o-control, field" layoutX="250.0" layoutY="158.0" prefHeight="40.0" prefWidth="200.0">
                    <properties validationField="email" />
                </TextField>
                <PasswordField fx:id="registerPasswordField" promptText="password" styleClass="o-control, field" layoutX="250.0" layoutY="218.0" prefHeight="40.0" prefWidth="200.0">
                    <properties validationField="password" />
                </PasswordField>
                <PasswordField fx:id="registerPasswordConfirmField" promptText="repeat password" styleClass="o-control, field" layoutX="250.0" layoutY="278.0" prefHeight="40.0" prefWidth="200.0">
                    <properties validationField="passwordConfirmation" validationDependsOn="password" />
                </PasswordField>
                <Button fx:id="registerButton" text="REGISTER" mnemonicParsing="false" styleClass="o-control, app-button, app-button--primary" layoutX="250.0" layoutY="338.0" prefHeight="39.0" prefWidth="200.0" />
                <Label fx:id="feedbackLabel" styleClass="auth-page__feedback" layoutX="40.0" layoutY="388.0" prefWidth="620.0" prefHeight="125.0" alignment="TOP_CENTER" textAlignment="CENTER" wrapText="true">
                    <properties validationFeedback="true" />
                </Label>
            </children>
        </AnchorPane>
        <fx:include fx:id="header" source="../components/header.fxml" />
    </children>
</AnchorPane>
