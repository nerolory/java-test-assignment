{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Run Main (JavaFX)",
            "request": "launch",
            "mainClass": "app.Main",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Java: Build application",
            "vmArgs": "--module-path \"${workspaceFolder}/.deps/javafx-sdk-26.0.2/lib\" --add-modules javafx.controls,javafx.fxml --enable-native-access=javafx.graphics,ALL-UNNAMED"
        }
    ]
}
